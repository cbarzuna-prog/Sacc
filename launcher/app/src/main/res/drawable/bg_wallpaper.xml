<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo estatico cinematografico hecho solo con degradados: no ocupa memoria de bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#04050A"
                android:startColor="#0E1424" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#2A4A5A8C"
                android:startColor="#00000000" />
        </shape>
    </item>
</layer-list>
